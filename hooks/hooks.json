{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/notify complete ${CLAUDE_PLUGIN_ROOT}/audio/voices/${user_config.voice}/notify-complete.mp3",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/notify confirm ${CLAUDE_PLUGIN_ROOT}/audio/voices/${user_config.voice}/notify-confirm.mp3",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/notify error ${CLAUDE_PLUGIN_ROOT}/audio/voices/${user_config.voice}/notify-error.mp3",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/notify progress ${CLAUDE_PLUGIN_ROOT}/audio/voices/${user_config.voice}/notify-progress.mp3",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ]
  }
}
